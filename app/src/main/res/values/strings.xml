    <string name="btn_grant_permissions">Cấp quyền</string>
    <string name="setting_service_missing_perms_warning">⚠️ Dịch vụ giám sát đang tắt vì chưa được cấp đủ quyền Bluetooth hoặc Vị trí. Hãy bấm kiểm tra quyền bên dưới để kích hoạt.</string>
