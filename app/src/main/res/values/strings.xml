    <string name="dialog_clear_all_message">Hành động này sẽ xóa vĩnh viễn danh sách mọi thiết bị và toàn bộ dòng thời gian sự kiện đã lưu trên máy.</string>

    <!-- Permission Onboarding Screen -->
    <string name="onboarding_welcome_title">Chào mừng tới BT Watcher</string>
    <string name="onboarding_welcome_desc">Để ghi lại mốc giờ kết nối và vị trí GPS của thiết bị Bluetooth khi ngắt/kết nối, app cần quyền hệ thống sau:</string>
    <string name="permission_bt_title">1. Quyền Bluetooth</string>
    <string name="permission_bt_desc">Nhận diện tên và trạng thái kết nối/ngắt kết nối của tai nghe, loa, đồng hồ đã ghép đôi.</string>
    <string name="permission_loc_title">2. Quyền Vị trí (GPS)</string>
    <string name="permission_loc_desc">Lấy tọa độ GPS ngay tại thời điểm thiết bị kết nối hoặc ngắt kết nối để bạn biết thiết bị ở đâu.</string>
    <string name="permission_notif_title">3. Quyền Thông báo</string>
    <string name="permission_notif_desc">Duy trì dịch vụ chạy nền liên tục và gửi cảnh báo ngay nếu thiết bị ngắt kết nối bất ngờ.</string>

